{
  "name": "pressdock-settings-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:dev": "wrangler deploy",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@types/node": "^26.6.5",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  }
}
